{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/admin/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/skin.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/admin/boot-cache.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__rwtest",
      "destination": "/card/index.html"
    },
    {
      "source": "/__hastest",
      "has": [{ "type": "host", "value": "www.menteaweb.com" }],
      "destination": "/card/index.html"
    },
    {
      "source": "/card",
      "destination": "/__card_page_has_no_public_path__"
    },
    {
      "source": "/card/:path*",
      "destination": "/__card_page_has_no_public_path__"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "card.menteaweb.com" }],
      "destination": "/card/index.html"
    }
  ]
}
